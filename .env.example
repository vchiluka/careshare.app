# CareShare environment. Copy to .env.local for development. Never commit real values.
# Every integration defaults to mock; set the switch and the vendor variables to go live.

# Demo clock (YYYY-MM-DD). Unset = today.
DEMO_AS_OF=2026-10-24

# Signs the session cookies (caregiver/staff demo sessions, verification and Medicare flow state). 16+ chars. Required in production.
CARESHARE_SECRET=change-me-to-a-long-random-string

# ---- Store ----
# memory (default) is per process: for `npm run dev` and unit tests only. Every deployed environment uses
# Postgres on Neon; on Vercel a missing DATABASE_URL is an error, not a fallback (ALLOW_MEMORY_STORE=1 for
# a throwaway preview). The schema comes from db/migrations (npm run db:migrate, run by CI before a deploy);
# staging and preview branches are seeded by npm run db:seed; production is never seeded.
# STORE_DRIVER=postgres                 # memory | postgres | blob (overrides the automatic choice)
# STORE_DRIVER=blob + BLOB_READ_WRITE_TOKEN   only the v1 demo project (release/v1.0-rfa-baseline); refused in production
# DATABASE_URL=postgres://...           # Neon POOLED connection string for the app at runtime
# DATABASE_URL_UNPOOLED=postgres://...  # Neon DIRECT connection string; migrations and seeding only (CI secret)
# DATABASE_POOL_MAX=5                   # connections per serverless instance
# CARESHARE_ENV=production              # set only in production: refuses seed, reset and migrate --down
# TEST_DATABASE_URL=postgres://careshare_app@127.0.0.1:5433/careshare_test   # npm run test:db (non-superuser role)

# ---- Identity proofing (NIST IAL2/AAL2) ----
IDENTITY_CLEAR=mock            # mock | live
IDENTITY_IDME=mock             # mock | live

# CLEAR Verified (OIDC). Redirect URI to allowlist in the CLEAR console: https://<host>/api/identity/callback/clear
# Sandbox vs production is chosen per client in the CLEAR console (same endpoints). Endpoints default to
# https://verified.clearme.com/integrations/oauth2/{auth,token} and .../.well-known/jwks.json (docs.clearme.com).
# CLEAR_CLIENT_ID=
# CLEAR_CLIENT_SECRET=
# CLEAR_REDIRECT_URI=https://<host>/api/identity/callback/clear
# CLEAR_SCOPES=openid                  # default; add offline_access only if you want a refresh token
# CLEAR_TOKEN_AUTH=client_secret_post  # default; or client_secret_basic
# CLEAR_ASSURANCE_MODE=scope           # scope (default: a successful CLEAR verification = IAL2/AAL2) | claims
# CLEAR_ISSUER= CLEAR_AUTHORIZATION_ENDPOINT= CLEAR_TOKEN_ENDPOINT= CLEAR_JWKS_URI= CLEAR_USERINFO_ENDPOINT=   # overrides, normally unset

# ID.me (OIDC). Redirect URI to register: https://<host>/api/identity/callback/idme
# IDME_CLIENT_ID=
# IDME_CLIENT_SECRET=
# IDME_REDIRECT_URI=https://<host>/api/identity/callback/idme
# IDME_ISSUER=https://api.idmelabs.com/oidc   # sandbox; production https://api.id.me/oidc (discovery is found at the host root automatically)
# IDME_SCOPES=openid nist_aal2_ial2           # "openid <policy handle>"; the handle is per app in the ID.me console (nist_aal2_ial2 = NIST IAL2/AAL2)
# IDME_TOKEN_AUTH=client_secret_post
# IDME_ASSURANCE_MODE=scope

# ---- CMS Blue Button 2.0 ----
# Register the app at https://sandbox.bluebutton.cms.gov (Developer Sandbox → Add an application). Redirect URI:
# https://<host>/api/medicare/callback. The sandbox serves synthetic beneficiaries; the mock produces the same FHIR shapes.
BLUEBUTTON_ADAPTER=mock        # mock | live
# BB_CLIENT_ID=
# BB_CLIENT_SECRET=
# BB_REDIRECT_URI=https://<host>/api/medicare/callback
# BB_BASE_URL=https://sandbox.bluebutton.cms.gov   # production: https://api.bluebutton.cms.gov
# BB_SCOPES=patient/Patient.read patient/Coverage.read patient/ExplanationOfBenefit.read
# BB_MAX_PAGES=10              # pagination cap per resource type on import

# ---- EHR (FHIR R4, SMART Backend Services) ----
EHR_ADAPTER=mock               # mock | generic-fhir
# FHIR_BASE_URL=
# FHIR_CLIENT_ID=
# FHIR_PRIVATE_KEY_PEM=        # PKCS8 PEM; \n escapes allowed
# FHIR_KEY_ID=
# FHIR_SCOPES=system/Patient.rs system/Condition.rs system/Encounter.rs system/CarePlan.cu system/DocumentReference.c

# ---- Community directory ----
DIRECTORY_ADAPTER=mock         # mock | virginianavigator
# VN_API_BASE_URL=
# VN_API_KEY=

# ---- SMS ----
SMS_ADAPTER=mock               # mock | twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
